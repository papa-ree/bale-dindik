    "keywords": [
        "bale",
        "laravel",
        "bale-dindik"
    ],
    "homepage": "https://github.com/bale/bale-dindik",
    "license": "MIT",
    "authors": [
        {
            "name": "Papa Ree",
            "email": "ricky.romdhoni@gmail.com",
